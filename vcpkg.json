{
  "$schema": "https://raw.githubusercontent.com/Microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "algebraic-hashing",
  "version": "2.0.0",
  "description": "Modern C++20 library for algebraic hash function composition",
  "homepage": "https://github.com/algebraic-hashing/algebraic_hashing",
  "license": "MIT",
  "supports": "!uwp & !xbox",
  "dependencies": [],
  "features": {
    "tests": {
      "description": "Build tests",
      "dependencies": [
        {
          "name": "gtest",
          "platform": "!uwp"
        }
      ]
    },
    "examples": {
      "description": "Build examples and tutorials"
    },
    "benchmarks": {
      "description": "Build performance benchmarks"
    }
  },
  "default-features": [
    "examples"
  ]
}